# Copy this file to .env for local development (wrangler pages dev reads it).
# Real values live in the Cloudflare Pages dashboard for deployed builds —
# never commit an actual .env file (it's gitignored).

# Cloudflare Pages Functions only — never prefixed VITE_, never shipped to the browser.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
RESEND_API_KEY=your-resend-api-key-here
PUB_NOTIFICATION_EMAIL=thewhitelionamersham@outlook.com

# Added in Phase 1 only, once the admin panel needs a browser-side Supabase session.
# VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-here
